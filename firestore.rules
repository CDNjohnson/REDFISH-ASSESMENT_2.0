rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Admin allowlist. Add more emails here (comma-separated, each in quotes) if
    // anyone else should be able to sign in to admin.html and see results.
    function isAdmin() {
      return request.auth != null &&
        request.auth.token.email in [
          'johnson@redfish.llc',
          'mitchell@redfish.llc'
        ];
    }

    match /submissions/{submissionId} {
      // Candidates (no login) can submit a result, but never read, edit, or delete one.
      allow create: if request.resource.data.keys().hasAll(['name', 'comp', 'ops', 'reasoning', 'learning'])
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() < 200;
      allow read, list: if isAdmin();
      allow update, delete: if isAdmin();
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
